{
  "name": "@tk-auto/desktop",
  "version": "1.4.101",
  "private": true,
  "description": "本地优先的 TikTok Ads 自动化管理工具",
  "author": "TK Ads Automation",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "node build.mjs",
    "dist": "pnpm --filter @tk-auto/web build && node build.mjs && electron-builder --win nsis --x64 && node scripts/verify-packaged-scheduler.mjs",
    "dist:signed": "node scripts/require-signing-env.mjs && pnpm --filter @tk-auto/web build && node build.mjs && electron-builder --win nsis --x64 && node scripts/verify-packaged-scheduler.mjs && node scripts/verify-release-signature.mjs",
    "release:manifest": "node scripts/generate-signed-update-manifest.mjs"
  },
  "devDependencies": {
    "@fastify/static": "latest",
    "@tk-auto/api": "workspace:*",
    "@tk-auto/core": "workspace:*",
    "@tk-auto/credentials": "workspace:*",
    "@tk-auto/storage": "workspace:*",
    "@types/node": "^24.10.1",
    "electron": "latest",
    "electron-builder": "latest",
    "esbuild": "latest",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.tkads.automation",
    "productName": "TK Ads Automation",
    "copyright": "Copyright © 2026",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.cjs",
      "package.json",
      "build/icon.ico"
    ],
    "afterPack": "scripts/prepare-background-program.mjs",
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../mcp/dist",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TK-Ads-Automation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TK Ads Automation",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
