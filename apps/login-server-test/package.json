{
  "name": "@tk-auto/login-server-test",
  "version": "1.3.0-login-server-test.1",
  "private": true,
  "description": "Isolated central-login development server for TK Ads Automation",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "secrets": "node scripts/generate-secrets.mjs",
    "credentials:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-credentials.ps1",
    "start": "node --env-file=../../.env.login-test dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "@tk-auto/api": "workspace:*",
    "@tk-auto/credentials": "workspace:*",
    "@tk-auto/storage": "workspace:*",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "latest",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
