{
  "name": "tk-ads-automation",
  "version": "1.4.32",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tk-auto/api --filter @tk-auto/web dev",
    "dev:api": "pnpm --filter @tk-auto/api dev",
    "dev:web": "pnpm --filter @tk-auto/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "desktop:build": "pnpm --filter @tk-auto/web build && pnpm --filter @tk-auto/desktop build",
    "desktop:run": "pnpm desktop:build && pnpm --filter @tk-auto/desktop start",
    "desktop:dist": "pnpm desktop:build && pnpm --filter @tk-auto/desktop dist",
    "login-test:secrets": "pnpm --filter @tk-auto/login-server-test secrets",
    "login-test:credentials:export": "pnpm --filter @tk-auto/login-server-test credentials:export",
    "login-test:build": "pnpm --filter @tk-auto/web build && pnpm --filter @tk-auto/login-server-test build",
    "login-test:start": "pnpm login-test:build && pnpm --filter @tk-auto/login-server-test start",
    "docs:generate": "node scripts/generate-manual.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
